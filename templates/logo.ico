<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
  <!-- Fundo escuro com cantos arredondados -->
  <rect width="120" height="120" rx="28" fill="#0F172A"/>

  <!-- Moldura/Retângulo de Escaneamento (Corners) -->
  <path d="M 28 42 V 28 H 42" stroke="#38BDF8" stroke-width="5" stroke-linecap="round" fill="none"/>
  <path d="M 92 42 V 28 H 78" stroke="#38BDF8" stroke-width="5" stroke-linecap="round" fill="none"/>
  <path d="M 28 78 V 92 H 42" stroke="#38BDF8" stroke-width="5" stroke-linecap="round" fill="none"/>
  <path d="M 92 78 V 92 H 78" stroke="#38BDF8" stroke-width="5" stroke-linecap="round" fill="none"/>

  <!-- Silhueta Minimalista do Rosto -->
  <!-- Cabeça -->
  <circle cx="60" cy="50" r="14" fill="#E2E8F0"/>
  <!-- Ombro/Base -->
  <path d="M 40 82 C 40 68, 80 68, 80 82" fill="#E2E8F0"/>

  <!-- Pontos de Mapeamento Facial (Análise Biométrica) -->
  <circle cx="53" cy="48" r="2.5" fill="#22C55E"/>
  <circle cx="67" cy="48" r="2.5" fill="#22C55E"/>
  <circle cx="60" cy="55" r="2" fill="#22C55E"/>
  <circle cx="60" cy="61" r="2.5" fill="#22C55E"/>

  <!-- Linha Horizontal de Escanear -->
  <line x1="28" y1="60" x2="92" y2="60" stroke="#22C55E" stroke-width="2" stroke-dasharray="4 3" opacity="0.8"/>
</svg>
